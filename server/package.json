    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@mmw/shared": "workspace:^",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.2.7",
    "mailparser": "^3.9.36",
    "nodemailer": "^10.0.15",
    "sqlite-vec": "^0.1.9",
    "ulid": "^3.0.2",
    "zod": "^4.6.5"
  }
