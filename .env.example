# Copia in .env.local (escluso da git) e compila.

# Porta del backend (ascolta solo su 127.0.0.1)
MMW_PORT=4310
# Cartella dati: database SQLite e blob store
MMW_DATA_DIR=./data

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=bge-m3

# Account di prova (usato da `pnpm check:imap` e referenziabile dagli account come env:MMW_TEST_APP_PASSWORD)
MMW_TEST_EMAIL=
MMW_TEST_APP_PASSWORD=
